{
  "version": 1,
  "_comment": "Shared pronunciation dictionary for PsyonVox. Consumed by BOTH the web app (src/lib/pronounce.ts) and the Python batch script (scripts/psyonvox-batch, Phase 6) so speech is consistent across both. 'terms' = case-insensitive whole-token replacements (spoken form). 'patterns' = regex rewrites applied first (e.g. CVE ids). Users can add their own overrides in Settings; those are merged on top of this base.",
  "patterns": [
    { "re": "CVE-(\\d{4})-(\\d{3,7})", "flags": "gi", "to": "C V E, $1, $2" },
    { "re": "ISO/IEC", "flags": "g", "to": "I S O, I E C" },
    { "re": "\\bSOC\\s*2\\b", "flags": "gi", "to": "sock two" },
    { "re": "\\b800-(\\d{1,3})\\b", "flags": "g", "to": "eight hundred dash $1" }
  ],
  "terms": {
    "NIST": "nist",
    "ISO": "I S O",
    "IEC": "I E C",
    "GRC": "G R C",
    "SACP": "S A C P",
    "MITRE": "my-ter",
    "ISACA": "eye-sack-uh",
    "CISM": "sism",
    "CISA": "C I S A",
    "CISSP": "C I S S P",
    "SIEM": "sim",
    "SOAR": "sore",
    "IAM": "I A M",
    "PII": "P I I",
    "GDPR": "G D P R",
    "HIPAA": "hip-uh",
    "PCI": "P C I",
    "DSS": "D S S",
    "OWASP": "oh-wasp",
    "SaaS": "sass",
    "PaaS": "pass",
    "IaaS": "eye-as",
    "MFA": "M F A",
    "SSO": "S S O",
    "VPN": "V P N",
    "TLS": "T L S",
    "SSL": "S S L",
    "DNS": "D N S",
    "API": "A P I",
    "CVE": "C V E",
    "CWE": "C W E",
    "CVSS": "C V S S",
    "RBAC": "are-back",
    "ABAC": "ay-back",
    "SOC": "sock",
    "NDA": "N D A",
    "SLA": "S L A",
    "RTO": "R T O",
    "RPO": "R P O",
    "BCP": "B C P",
    "EDR": "E D R",
    "XDR": "X D R",
    "MDR": "M D R",
    "IDS": "I D S",
    "IPS": "I P S",
    "WAF": "waff",
    "CASB": "caz-bee",
    "ZTNA": "Z T N A",
    "SASE": "sassy"
  }
}
